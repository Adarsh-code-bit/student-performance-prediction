# Server
PORT=5000
CLIENT_URL=http://localhost:5173
# Optional comma-separated additional trusted origins
FRONTEND_ORIGINS=

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=smart_inventory

# Database SSL / TLS (for cloud providers such as Aiven)
DB_SSL=false
# Leave unset or 'true' for strict CA verification; 'false' only for unverified dev environments
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional PEM CA certificate string for verified TLS with cloud databases (e.g. Aiven CA certificate)
# In Render/cloud dashboards, paste the entire PEM certificate: "-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
DB_SSL_CA=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=24h


