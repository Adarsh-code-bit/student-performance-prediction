# -------------------------------------------------------------
# QUICKSTOCK Backend Environment Configuration (.env.example)
# Copy to .env and provide your deployment-specific credentials.
# NEVER commit .env to version control.
# -------------------------------------------------------------

# Server Configuration
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# CORS & Trusted Frontend Origins
# Single primary frontend origin (e.g. https://quickstock.railway.app or https://smart-inventory-rouge-theta.vercel.app)
CLIENT_URL=http://localhost:5173
# Optional comma-separated additional trusted origins
FRONTEND_ORIGINS=https://localhost:5173,http://127.0.0.1:5173

# Database Connection (Option A: Individual Variables)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=smart_inventory
DB_CONNECTION_LIMIT=10

# Database Connection (Option B: Full Connection String URL)
# Provided automatically by Railway MySQL plugin (e.g. mysql://user:password@host:port/dbname)
# DATABASE_URL=
# MYSQL_URL=

# Database SSL / TLS (for managed cloud databases such as Aiven or AWS RDS)
DB_SSL=false
# Set to 'true' for strict CA certificate verification in production
DB_SSL_REJECT_UNAUTHORIZED=true
# Inline PEM root certificate for verified TLS with cloud databases
DB_SSL_CA=
# Or path to PEM root certificate file
# DB_SSL_CA_PATH=

# JWT Authentication
# MUST be configured with at least 32 cryptographically secure random characters in production
JWT_SECRET=your_32_character_minimum_random_secret_here
JWT_EXPIRES_IN=24h

# SMS OTP Provider Configuration
# Options: 'CONSOLE' (local dev mock), 'TWILIO', 'AWS_SNS', 'CUSTOM_HTTP'
# In production, 'CONSOLE' is blocked; configure a real provider or omit public signup OTP.
SMS_PROVIDER=CONSOLE
OTP_SECRET_SALT=quickstock_production_otp_salt_change_me

# Twilio Credentials (required if SMS_PROVIDER=TWILIO)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# AWS SNS Credentials (required if SMS_PROVIDER=AWS_SNS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Custom HTTP SMS Gateway (required if SMS_PROVIDER=CUSTOM_HTTP)
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
