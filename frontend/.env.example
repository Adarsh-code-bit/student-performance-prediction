# -------------------------------------------------------------
# QUICKSTOCK Frontend Environment Configuration (.env.example)
# -------------------------------------------------------------

# In development with Vite proxy:
# VITE_API_URL=/api
# VITE_API_BASE_URL=/api

# In production (set to your deployed Backend API URL, e.g. Railway or Render):
# VITE_API_URL=https://smart-inventory-backend-production.up.railway.app/api
# VITE_API_BASE_URL=https://smart-inventory-backend-production.up.railway.app/api
VITE_API_URL=/api
VITE_API_BASE_URL=/api
